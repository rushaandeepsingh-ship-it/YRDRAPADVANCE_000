managed implementation in class yrdbp_r_ordertp_000 unique;
strict ( 2 );
with collaborative draft;
with cross associations;

define behavior for YRDR_OrderTP_000 //alias <alias_name>
persistent table zyrdorder000
with additional save
draft table zyrdorder000_d query YRDR_OrderDraftTP_000
lock master
total etag LastChangedAt
authorization master ( instance )
etag master LocalLastChangedAt
changedocuments master ( YRD_ORDER_CDH )
{

  changedocuments ( create : key, update : data, delete : none );

  create ( authorization : global ) { default function GetDefaultsForCreate; }
  update;
  delete;

  draft action Edit;
  draft action Activate optimized;
  draft action Resume;
  draft action Discard;
  draft action Share;
  draft determine action Prepare
  {
    validation check_order_date;
    validation YRDR_OrderItemTP_000~checkMandatoryFields;
  }

  field ( readonly )
  UUID,
  OrderId,
  NetAmount,
  CurrencyCode,
  LocalCreatedBy,
  LocalCreatedAt,
  LocalLastChangedBy,
  LocalLastChangedAt,
  LastChangedAt;

  // Managed numbering for GUID generation
  field ( numbering : managed ) Uuid;
  // Dynamic Feature Control - Fields
  field ( features : instance ) CustomerId;
  // Static feature control - Fields
  //  field ( mandatory : create, readonly : update ) CustomerId;
  // Dynamic Feayure control - Operations
  association _Item { create ( features : instance ); with draft; }

  association _Customer { with draft; link action LinkAction;
                                      unlink action UnLinkAction;
                                      inverse function InverseFunction; }
  // Validations
  validation check_order_date on save { field OrderDate; }

  // Determination
  determination fill_status on modify { field CustomerId; }

  determination set_order_id on save { create; }

  // Action
  action ( features : instance ) changeStatus parameter YRD_D_OrderStatusP result [1] $self;

  factory action ( features : instance ) copy deep parameter YRD_D_ORDERCOPYP [1] { default function GetDefaultsForCopy; }

  // internal Action
  internal action CalctNetAmount;

  // Determine Action
  determine action checkOrderDate { validation check_order_date; }

  // Events for side effects
  event orderStatusUpdated for side effects;

  // Events for local consumption
  event orderStatusUpdatedLocal parameter YRD_D_OrderStatus_000_P;

  // Side Effects
  side effects
  {
    determine action checkOrderDate executed on field OrderDate affects messages;
    field Status affects permissions ( create _Item, field NetAmount );
    event orderStatusUpdated affects field Status, field OrderDate;
  }
  // Mapping of DB fields with Entity fields
  mapping for zyrdorder000 corresponding
    {
      Uuid               = uuid;
      OrderId            = order_id;
      Status             = status;
      CustomerId         = customer_id;
      CurrencyCode       = currency_code;
      OrderDate          = order_date;
      NetAmount          = net_amount;
      LastChangedAt      = last_changed_at;
      LocalCreatedAt     = local_created_at;
      LocalCreatedBy     = local_created_by;
      LocalLastChangedAt = local_last_changed_at;
      LocalLastChangedBy = local_last_changed_by;
    }
}

define behavior for YRDR_OrderItemTP_000 //alias <alias_name>
persistent table zyrditem000
with additional save
draft table zyrditem000_d
lock dependent by _Order
authorization dependent by _Order
etag dependent by _Order
changedocuments dependent by _Order
{
  changedocuments ( delete : data, create : data );

  update ( features : instance );
  delete;

  field ( readonly )
  UUID,
  ParentUUID,
  ItemId;


  field ( numbering : managed )
  UUID;

  //  field ( mandatory : create, readonly : update ) ProductId;

  field ( features : instance ) ProductId;

  determination set_item_id on save { create; }

  determination calculateOrderprice on modify { field Amount; }

  validation checkMandatoryFields on save { create; update; }

  association _Order { with draft; }

  side effects
  {
    field Amount affects field _Order.NetAmount, field _Order.CurrencyCode;
  }

  mapping for zyrditem000 corresponding
    {
      Amount       = amount;
      CurrencyCode = currency_code;
      ItemId       = item_id;
      ParentUuid   = parent_uuid;
      ProductId    = product_id;
      ReqQuantity  = req_quantity;
      Status       = status;
      Uom          = uom;
      Uuid         = uuid;
    }
}